{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RMS publisher authorized snapshot",
  "type": "object",
  "required": [
    "contractVersion",
    "state",
    "session"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "state": {
      "type": "object",
      "required": [
        "demoDate",
        "settings",
        "boards",
        "classifications",
        "doctors",
        "users",
        "programs",
        "applications",
        "matches",
        "faqs",
        "questions",
        "documentTypes"
      ],
      "properties": {
        "demoDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Business reference date supplied by server; legacy field name retained for UI compatibility."
        },
        "settings": {
          "type": "object",
          "required": [
            "homeVisible",
            "homeOrder",
            "staleMonths"
          ]
        },
        "boards": {
          "type": "object",
          "required": [
            "notice",
            "resources"
          ],
          "properties": {
            "notice": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/boardRow"
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/boardRow"
              }
            }
          }
        },
        "classifications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        },
        "doctors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        },
        "faqs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        },
        "documentTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ]
          },
          "description": "Field structure: contracts/snapshot.example.json and docs/07-data-contract.md"
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "enum": [
            "visitor",
            "company",
            "tp",
            "admin"
          ]
        },
        "companyId": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "documents",
          "company",
          "header",
          "xml",
          "fieldCount",
          "populatedCount",
          "emptyCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "documents": {
            "type": "array"
          },
          "xml": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "description": "Command result. startApplication/saveDoctor/saveProgram return saved record ID; others may use null."
    }
  },
  "definitions": {
    "boardRow": {
      "type": "object",
      "required": [
        "id",
        "title",
        "date",
        "category",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "attachment": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
